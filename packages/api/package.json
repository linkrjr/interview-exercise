{
  "name": "@mc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run --passWithNoTests",
    "start": "node dist/bin/server.js",
    "keygen": "node dist/bin/keygen.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@mc/contracts": "workspace:*",
    "@mc/core": "workspace:*",
    "@mc/db": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "bin": {
    "mc-api": "./dist/bin/server.js"
  },
  "devDependencies": {
    "jose": "^6.2.12"
  }
}
