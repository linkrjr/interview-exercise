# Copy to .env for local development. docker-compose.yml falls back to these values.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres

# Passwords given to the application roles by the provisioning step (never stored in migrations).
APP_TENANT_PASSWORD=dev-tenant-password
APP_PLATFORM_PASSWORD=dev-platform-password
APP_SCHEDULER_PASSWORD=dev-scheduler-password

# Connection URLs used by the application processes (localhost, outside docker-compose).
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@localhost:5432/mission_control
DATABASE_URL_TENANT=postgres://app_tenant:dev-tenant-password@localhost:5432/mission_control
DATABASE_URL_PLATFORM=postgres://app_platform:dev-platform-password@localhost:5432/mission_control
DATABASE_URL_SCHEDULER=postgres://app_scheduler:dev-scheduler-password@localhost:5432/mission_control
